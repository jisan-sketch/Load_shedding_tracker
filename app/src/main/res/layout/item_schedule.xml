<?xml version="1.0" encoding="utf-8"?>
<!-- LAYOUT TYPE: LinearLayout (Modern card with left color accent bar and custom ScheduleAdapter pattern) -->
<!-- LECTURE TOPIC: Custom ListView Item Layout with convertView reuse & ViewHolder pattern -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Outage Icon Indicator -->
        <ImageView
            android:id="@+id/img_schedule_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_schedule_card"
            android:background="@drawable/bg_circle_icon_amber"
            android:padding="9dp"
            android:contentDescription="Outage Indicator"
            android:layout_marginEnd="14dp" />

        <!-- Text Information Column taking available weight -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_schedule_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 AM – 11:30 AM"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/tv_schedule_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khulna • Feeder 4"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status Chip (Scheduled / Restored) -->
        <TextView
            android:id="@+id/tv_schedule_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scheduled"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_circle_icon_amber"
            android:textColor="#D97706" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
