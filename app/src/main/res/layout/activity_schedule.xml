<?xml version="1.0" encoding="utf-8"?>
<!-- LAYOUT TYPE: LinearLayout with TableLayout (Weekly Schedule Matrix) and Custom ListView -->
<!-- LECTURE TOPIC: Custom ListView + ScheduleContentProvider + TableLayout View -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_schedule_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_schedule_back"
            android:layout_marginStart="12dp"
            android:text="Outage Timetable"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_schedule_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Schedule: Khulna"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/tv_schedule_area_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loaded from local ScheduleContentProvider database"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Custom ListView demonstrating ScheduleAdapter with convertView reuse -->
            <ListView
                android:id="@+id/lv_today_schedule"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:clipToPadding="false" />

            <!-- 2. TABLELAYOUT (LECTURE 8 TOPIC: TableLayout) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEEKLY SCHEDULE MATRIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/textSecondary"
                android:letterSpacing="0.05"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Weekly Schedule TableLayout inside clean card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface">

                <TableLayout
                    android:id="@+id/table_weekly_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0,1,2"
                    android:padding="12dp">

                    <!-- Table Header Row -->
                    <TableRow
                        android:background="#FEF3C7"
                        android:padding="10dp">
                        <TextView
                            android:text="Day"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:gravity="center" />
                        <TextView
                            android:text="Morning Slot"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:gravity="center" />
                        <TextView
                            android:text="Evening Slot"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:gravity="center" />
                    </TableRow>

                    <!-- Table Data Rows -->
                    <TableRow android:padding="10dp">
                        <TextView android:text="Sunday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="10:00 - 11:30" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="08:00 - 09:00" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp" android:background="#F8FAFC">
                        <TextView android:text="Monday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="11:30 - 01:00" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="09:00 - 10:00" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp">
                        <TextView android:text="Tuesday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="10:00 - 11:30" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="07:30 - 08:30" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp" android:background="#F8FAFC">
                        <TextView android:text="Wednesday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="01:00 - 02:30" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="08:00 - 09:00" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp">
                        <TextView android:text="Thursday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="10:00 - 11:30" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="06:30 - 07:30" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp" android:background="#DCFCE7">
                        <TextView android:text="Friday" android:textStyle="bold" android:textColor="@color/success" android:gravity="center" />
                        <TextView android:text="No Cut (Holiday)" android:textColor="@color/success" android:gravity="center" />
                        <TextView android:text="No Cut (Holiday)" android:textColor="@color/success" android:gravity="center" />
                    </TableRow>

                    <TableRow android:padding="10dp">
                        <TextView android:text="Saturday" android:textStyle="bold" android:textColor="@color/textPrimary" android:gravity="center" />
                        <TextView android:text="03:00 - 04:30" android:textColor="@color/textSecondary" android:gravity="center" />
                        <TextView android:text="08:30 - 09:30" android:textColor="@color/textSecondary" android:gravity="center" />
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button to seed or refresh data via ContentProvider -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_sample_schedule"
                style="@style/Widget.LoadShedding.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:text="Add Sample Schedule via ContentProvider" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
