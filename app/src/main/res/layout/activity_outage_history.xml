<?xml version="1.0" encoding="utf-8"?>
<!-- LAYOUT TYPE: LinearLayout (Vertical linear container with control header and RecyclerView) -->
<!-- LECTURE TOPIC: RecyclerView with LayoutManager Toggle (Linear vs Grid) & Cloud Firestore Read -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_outage_history_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_outage_history_back"
            android:layout_marginStart="12dp"
            android:text="Outage History"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- LECTURE TOPIC: LayoutManager variety (toggle between Linear and Grid at runtime) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_layout_manager"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Grid View"
            android:textColor="@color/white"
            app:strokeColor="#80FFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            app:cornerRadius="10dp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recorded Outages"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <TextView
            android:id="@+id/tv_history_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time logs synced with Cloud Firestore"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/pb_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/primary"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:id="@+id/layout_empty_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="60dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_history_card"
                android:background="@drawable/bg_circle_icon_purple"
                android:padding="14dp"
                android:contentDescription="No history" />

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No outage logs found for this area.\nOutages will appear here once recorded!"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Outage History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_outage_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
