<?xml version="1.0" encoding="utf-8"?>
<!-- LAYOUT TYPE: LinearLayout with custom header and MaterialCardViews for permissions -->
<!-- LECTURE TOPIC: Runtime Permissions Management (RequestMultiplePermissions) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Modern Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_permissions_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_permissions_back"
            android:layout_marginStart="12dp"
            android:text="App Permissions"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Access &amp; Privileges"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required for notifications, content providers, dialer &amp; location"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <!-- 1. POST_NOTIFICATIONS (Android 13+) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_stat_bolt"
                            android:background="@drawable/bg_circle_icon_amber"
                            android:padding="6dp"
                            app:tint="@color/accent"
                            android:contentDescription="Notification" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="POST_NOTIFICATIONS"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:id="@+id/tv_perm_status_notifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allows the app to show upcoming power cut alerts and foreground service countdown timer."
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. READ_CONTACTS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_person"
                            android:background="@drawable/bg_circle_icon_purple"
                            android:padding="6dp"
                            app:tint="@color/primary"
                            android:contentDescription="Contacts" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="READ_CONTACTS"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:id="@+id/tv_perm_status_contacts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allows selecting family members via Android ContactsContract Content Provider to receive outage SMS alerts."
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. ACCESS_FINE_LOCATION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_location_pin"
                            android:background="@drawable/bg_circle_icon_blue"
                            android:padding="6dp"
                            app:tint="@color/primary"
                            android:contentDescription="Location" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ACCESS_FINE_LOCATION"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:id="@+id/tv_perm_status_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-detects whether user is in Khulna, Dhaka, or other divisions to automatically select their load-shedding zone."
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. CALL_PHONE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_call_card"
                            android:background="@drawable/bg_circle_icon_green"
                            android:padding="6dp"
                            app:tint="@color/success"
                            android:contentDescription="Call" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CALL_PHONE"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:id="@+id/tv_perm_status_call"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Directly connects one-tap emergency calls to the national power control center at 16999."
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Request Permissions Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_permissions"
                style="@style/Widget.LoadShedding.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Request All Permissions"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
